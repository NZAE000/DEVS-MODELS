<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yahoo.stream</groupId>
        <artifactId>yahoo-low-latency-bechmarks</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>flink-benchmarks</artifactId>
    <packaging>jar</packaging>

    <name>Yahoo Streaming Benchmark - Flink</name>

    <dependencies>

        <!-- Logging API. Flink provides the concrete logging implementation. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JSON parsing used by the advertising event deserializer. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>

        <!-- Flink runtime dependencies supplied by the cluster. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>
                flink-streaming-java_${scala.binary.version}
            </artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>
                flink-clients_${scala.binary.version}
            </artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
        Keep the Kafka connector inside the shaded application JAR.
        It is not guaranteed to be included in the Flink distribution.
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>
                flink-connector-kafka_${scala.binary.version}
            </artifactId>
        </dependency>

        <!-- Shared event types, configuration and Redis utilities. -->
        <dependency>
            <groupId>com.yahoo.stream</groupId>
            <artifactId>streaming-benchmark-common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <finalName>flink-benchmarks-${project.version}</finalName>

        <plugins>

            <!--
            Adds Flink's program-class attribute to the JAR manifest.
            This permits:
                flink run flink-benchmarks-0.1.0.jar ...
            without explicitly specifying -c.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.0</version>

                <configuration>
                    <archive>
                        <manifestEntries>
                            <program-class>
                                flink.benchmark.AdvertisingTopologyNative
                            </program-class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Builds an executable fat JAR with non-provided dependencies. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>
                                false
                            </createDependencyReducedPom>

                            <minimizeJar>false</minimizeJar>

                            <shadedArtifactAttached>
                                false
                            </shadedArtifactAttached>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>

                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <transformers>
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <program-class>
                                            flink.benchmark.AdvertisingTopologyNative
                                        </program-class>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>