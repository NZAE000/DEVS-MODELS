<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yahoo.stream</groupId>
        <artifactId>yahoo-low-latency-bechmarks</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>flink-benchmarks</artifactId>
    <packaging>jar</packaging>

    <name>Yahoo Streaming Benchmark - Flink</name>

    <dependencies>

        <!--
        Flink supplies its logging implementation at runtime.
        The application only needs the SLF4J API for compilation.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JSON parsing used by the advertising event deserializer. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>

        <!--
        Flink runtime dependencies are supplied by the Flink 2.2 cluster and
        therefore must not be packaged inside the application JAR.
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
        Kafka connector for the modern KafkaSource API.

        This dependency is intentionally not marked as provided, so the shade
        plugin packages the connector and its required libraries into the
        benchmark JAR. This avoids requiring a separate connector installation
        under flink-2.2.0/lib.
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
        </dependency>

        <!-- Shared event types, configuration and Redis utilities. -->
        <dependency>
            <groupId>com.yahoo.stream</groupId>
            <artifactId>streaming-benchmark-common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <finalName>flink-benchmarks-${project.version}</finalName>

        <plugins>

            <!--
            Adds Flink's program-class manifest entry, allowing execution with:

                flink run flink-benchmarks-0.1.0.jar ...

            The runner script still supplies -c explicitly, so this entry also
            acts as a fallback for manual submissions.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>

                <configuration>
                    <archive>
                        <manifestEntries>
                            <program-class>
                                flink.benchmark.AdvertisingTopologyNative
                            </program-class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!--
            Builds one deployable application JAR containing all non-provided
            dependencies, including the Kafka connector and the shared Yahoo
            benchmark module.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>
                                false
                            </createDependencyReducedPom>

                            <minimizeJar>false</minimizeJar>

                            <shadedArtifactAttached>
                                false
                            </shadedArtifactAttached>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>

                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <transformers>
                                <!--
                                Required by service-loaded components such as
                                connector factories and serializers.
                                -->
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <program-class>
                                            flink.benchmark.AdvertisingTopologyNative
                                        </program-class>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>